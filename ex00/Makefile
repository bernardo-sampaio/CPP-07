CXX = c++
CXXFLAGS = -Wall -Werror -Wextra -std=c++98 
NAME = smm
SRCS = main.cpp
OBJS = $(SRCS:.cpp=.o)
HEADERS = templates.hpp

all: $(NAME)

$(OBJS): $(HEADERS)

$(NAME): $(OBJS)
	$(CXX) $(CXXFLAGS) $(OBJS) -o $(NAME)

clean:
	rm -f $(OBJS)

fclean: clean
	rm -f $(NAME)

re: fclean all

.PHONY: all clean fclean re